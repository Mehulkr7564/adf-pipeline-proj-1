{
	"name": "DS_Customers_Source",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_Gen2",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_fileName": {
				"type": "string",
				"defaultValue": "customers.csv"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().p_fileName",
					"type": "Expression"
				},
				"folderPath": "input",
				"fileSystem": "rawlayer"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "customer_id",
				"type": "String"
			},
			{
				"name": "name",
				"type": "String"
			},
			{
				"name": "email",
				"type": "String"
			},
			{
				"name": "city",
				"type": "String"
			},
			{
				"name": "age",
				"type": "String"
			}
		]
	}
}